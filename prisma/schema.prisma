// Schema do sistema de agendamento de quadras de areia - CEU
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// Usuários (contas de login dos clientes, com aprovação do admin)
// ----------------------------------------------------------------------------
enum StatusUsuario {
  PENDENTE
  APROVADO
  REJEITADO
}

model Usuario {
  id           Int           @id @default(autoincrement())
  nome         String
  email        String        @unique
  cpf          String?       @unique
  telefone     String
  fotoUrl      String?       @map("foto_url") // data URL (imagem redimensionada)
  senhaHash    String        @map("senha_hash")
  status       StatusUsuario @default(PENDENTE)
  criadoEm     DateTime      @default(now()) @map("criado_em")
  aprovadoEm   DateTime?     @map("aprovado_em")
  agendamentos Agendamento[]

  @@map("usuarios")
}

// ----------------------------------------------------------------------------
// Clientes
// ----------------------------------------------------------------------------
model Cliente {
  id           Int           @id @default(autoincrement())
  nome         String
  telefone     String
  email        String?
  criadoEm     DateTime      @default(now()) @map("criado_em")
  agendamentos Agendamento[]

  @@index([telefone])
  @@map("clientes")
}

// ----------------------------------------------------------------------------
// Quadras
// ----------------------------------------------------------------------------
model Quadra {
  id           Int           @id @default(autoincrement())
  nome         String
  descricao    String?
  ativa        Boolean       @default(true)
  agendamentos Agendamento[]
  bloqueios    Bloqueio[]

  @@map("quadras")
}

// ----------------------------------------------------------------------------
// Agendamentos
// ----------------------------------------------------------------------------
enum StatusAgendamento {
  PENDENTE
  CONFIRMADO
  CANCELADO
}

model Agendamento {
  id          Int               @id @default(autoincrement())
  clienteId   Int               @map("cliente_id")
  usuarioId   Int?              @map("usuario_id")
  quadraId    Int               @map("quadra_id")
  data        DateTime          @db.Date
  horaInicio  String            @map("hora_inicio") // "HH:MM"
  horaFim     String            @map("hora_fim") // "HH:MM"
  status      StatusAgendamento @default(PENDENTE)
  modalidade  String?
  observacoes String?
  // Código curto para o cliente cancelar/remarcar sem login
  codigo      String            @unique @default(cuid())
  criadoEm    DateTime          @default(now()) @map("criado_em")

  cliente   Cliente     @relation(fields: [clienteId], references: [id])
  usuario   Usuario?    @relation(fields: [usuarioId], references: [id])
  quadra    Quadra      @relation(fields: [quadraId], references: [id])
  pagamento Pagamento?

  // Impede duas reservas exatamente no mesmo início, na mesma quadra e data.
  // (a checagem completa de sobreposição é feita na API, dentro de transação)
  @@unique([quadraId, data, horaInicio])
  @@index([data])
  @@index([status])
  @@map("agendamentos")
}

// ----------------------------------------------------------------------------
// Horários de funcionamento (por dia da semana)
// ----------------------------------------------------------------------------
model HorarioFuncionamento {
  id         Int     @id @default(autoincrement())
  diaSemana  Int     @map("dia_semana") // 0 = domingo ... 6 = sábado
  horaInicio String  @map("hora_inicio") // "HH:MM"
  horaFim    String  @map("hora_fim") // "HH:MM"
  ativo      Boolean @default(true)

  @@unique([diaSemana])
  @@map("horarios_funcionamento")
}

// ----------------------------------------------------------------------------
// Bloqueios (feriados, manutenção, eventos)
// ----------------------------------------------------------------------------
model Bloqueio {
  id         Int      @id @default(autoincrement())
  quadraId   Int?     @map("quadra_id") // null = bloqueia todas as quadras
  data       DateTime @db.Date
  horaInicio String?  @map("hora_inicio") // null = dia inteiro
  horaFim    String?  @map("hora_fim")
  motivo     String?

  quadra Quadra? @relation(fields: [quadraId], references: [id])

  @@index([data])
  @@map("bloqueios")
}

// ----------------------------------------------------------------------------
// Publicações — Quadro de Avisos, Notícias, Eventos e Teatro/Cultura
// ----------------------------------------------------------------------------
enum TipoPublicacao {
  AVISO
  NOTICIA
  EVENTO
  TEATRO
}

model Publicacao {
  id         Int            @id @default(autoincrement())
  tipo       TipoPublicacao
  titulo     String
  resumo     String
  conteudo   String? // texto completo (opcional)
  local      String? // p/ eventos/teatro
  dataEvento DateTime? @map("data_evento") // p/ eventos/teatro
  imagemUrl  String?   @map("imagem_url")
  destaque   Boolean   @default(false) // aparece no Quadro de Avisos
  publicado  Boolean   @default(true) // visível no site
  criadoEm   DateTime  @default(now()) @map("criado_em")

  @@index([tipo])
  @@index([publicado])
  @@map("publicacoes")
}

// ----------------------------------------------------------------------------
// Pagamentos (opcional)
// ----------------------------------------------------------------------------
enum StatusPagamento {
  PENDENTE
  PAGO
  ESTORNADO
}

model Pagamento {
  id             Int             @id @default(autoincrement())
  agendamentoId  Int             @unique @map("agendamento_id")
  valor          Decimal         @db.Decimal(10, 2)
  metodoPagamento String         @map("metodo_pagamento") // PIX, DINHEIRO, CARTAO
  statusPagamento StatusPagamento @default(PENDENTE) @map("status_pagamento")
  criadoEm       DateTime        @default(now()) @map("criado_em")

  agendamento Agendamento @relation(fields: [agendamentoId], references: [id], onDelete: Cascade)

  @@map("pagamentos")
}
