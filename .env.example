# ==========================================
# Modelo de variáveis de ambiente
# Copie para .env e preencha:  cp .env.example .env
# ==========================================

# Banco de Dados (PostgreSQL)
DATABASE_URL="postgresql://usuario:senha@host:5432/agendamentoQuadra?schema=public"

# Área administrativa
ADMIN_EMAIL="admin@praiadonorte.com.br"
ADMIN_PASSWORD="troque-esta-senha"
AUTH_SECRET="string-aleatoria-bem-longa"

# E-mail via n8n (preferencial) - URL de Production do Webhook
N8N_EMAIL_WEBHOOK_URL=""

# E-mail (Brevo SMTP) - usado só se N8N_EMAIL_WEBHOOK_URL estiver vazio
BREVO_SMTP_KEY="sua-chave-smtp-do-brevo"
BREVO_SMTP_LOGIN="seu-login@exemplo.com"
EMAIL_FROM="contato@praiadonorte.com.br"
EMAIL_FROM_NAME="Praia do Norte"

# Contato / WhatsApp (exibido no site)
NEXT_PUBLIC_WHATSAPP="5532988370515"
NEXT_PUBLIC_TELEFONE="(32) 98837-0515"
NEXT_PUBLIC_ENDERECO="Rua Marília, 285 - Benfica, Juiz de Fora - MG, 36090-330"
